# Copy to .env.local and set your real values

# Google Tag Manager container ID (create at tagmanager.google.com, import gtm/profloor-gtm-container.json)
# GA4 measurement ID G-X1ZWZP75HF is configured inside GTM, not here.
NEXT_PUBLIC_GTM_ID=GTM-K9VX3FL6

# Google Maps / Places (address autocomplete on quote forms)
# Enable Maps JavaScript API + Places API in Google Cloud Console.
# Restrict the key by HTTP referrer: http://localhost:3000/* and https://profloorva.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# PostHog product analytics (Project settings → Project API key). Events are proxied via /ingest.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Airtable leads table (Pro Floor VA)
# Create a Personal Access Token at https://airtable.com/create/tokens
# Scopes: data.records:write (and schema.bases:read if you need to inspect fields)
# Access: this base (app9jvMglrggu8G5G).
# Server-only: never prefix the token with NEXT_PUBLIC_ (that ships it to browsers).
AIRTABLE_TOKEN=
NEXT_PUBLIC_AIRTABLE_BASE_ID=app9jvMglrggu8G5G
NEXT_PUBLIC_AIRTABLE_TABLE_ID=tblCrGsM19m556yoF
