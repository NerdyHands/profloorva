# Copy to .env.local and set your real values

# Google Tag Manager container ID (create at tagmanager.google.com, import gtm/profloor-gtm-container.json)
# GA4 measurement ID G-X1ZWZP75HF is configured inside GTM, not here.
NEXT_PUBLIC_GTM_ID=GTM-K9VX3FL6

# Google Maps / Places (address autocomplete on quote forms)
# Enable Maps JavaScript API + Places API in Google Cloud Console.
# Restrict the key by HTTP referrer: http://localhost:3000/* and https://profloorva.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opinly blog CMS (Settings → Developers). API key is server-only — never prefix with NEXT_PUBLIC_.
OPINLY_API_KEY=
OPINLY_CDN_NAMESPACE=
# Optional: publishable pixel key (pk-…)
NEXT_PUBLIC_OPINLY_WRITE_KEY=
# Shared secret for Opinly content webhook → /api/opinly/revalidate
OPINLY_WEBHOOK_SECRET=

# Airtable leads table (shared NerdyHands CRM)
# Base: https://airtable.com/appe6UzeNJTHKFRlj/tbl5fzjOKXf6J6oY4/viwa5eMzCPsPXwonE
# Create a Personal Access Token at https://airtable.com/create/tokens
# Scopes: data.records:write (and schema.bases:read if you need to inspect fields)
# Access: this base (appe6UzeNJTHKFRlj).
NEXT_PUBLIC_AIRTABLE_TOKEN=
NEXT_PUBLIC_AIRTABLE_BASE_ID=appe6UzeNJTHKFRlj
NEXT_PUBLIC_AIRTABLE_TABLE_ID=tbl5fzjOKXf6J6oY4

# Firebase web app config (Project settings > Your apps > Web)
# Enable Google sign-in under Authentication > Sign-in method
# Add localhost and your production domain under Authentication > Settings > Authorized domains
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
